<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C7C7C7"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:background="@color/verde"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/toolbar" />

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <Button
            android:id="@+id/btn1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margenes_laterales"
            android:layout_marginTop="@dimen/margenes_arriba"
            android:layout_marginEnd="@dimen/margenes_laterales"
            android:background="@color/verde"
            android:text="@string/btn1"
            app:backgroundTint="@color/verde" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2">
        <ImageButton
            android:id="@+id/imButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margenes_laterales"
            android:layout_marginTop="@dimen/margenes_arriba"
            android:layout_marginEnd="@dimen/margenes_laterales"
            android:layout_weight="0"
            android:backgroundTint="@color/verde"
            app:srcCompat="@android:drawable/ic_menu_save" />
        <Button
            android:id="@+id/btn3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margenes_laterales"
            android:layout_marginTop="@dimen/margenes_arriba"
            android:layout_marginEnd="@dimen/margenes_laterales"
            android:layout_weight="0"
            android:background="@android:color/holo_green_dark"
            android:text="@string/btn3"
            app:backgroundTint="@android:color/holo_green_dark"
            app:icon="?attr/actionModeCopyDrawable" />

        <TextView
            android:id="@+id/textViewButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout4">
        <ToggleButton
            android:id="@+id/toggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margenes_laterales"
            android:layout_marginTop="@dimen/margenes_arriba"
            android:layout_marginEnd="@dimen/margenes_laterales"
            android:layout_weight="0"
            android:background="@color/verde"
            android:checked="@bool/toggle_inicial"
            android:text="DESACTIVATED"
            android:textOff="@string/toggle_off"
            android:textOn="@string/toggle_on" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3"
        tools:layout_editor_absoluteX="0dp">

        <CheckBox
            android:id="@+id/cb1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margenes_laterales"
            android:layout_marginTop="@dimen/margenes_arriba"
            android:layout_marginEnd="@dimen/margenes_laterales"
            android:layout_weight="1"
            android:width="@dimen/margenes_laterales"
            android:button="@android:drawable/btn_star_big_on"
            android:checked="@bool/cb1_inicial"
            android:text="@string/cb1" />
        <CheckBox
            android:id="@+id/cb2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margenes_laterales"
            android:layout_marginTop="@dimen/margenes_arriba"
            android:layout_marginEnd="@dimen/margenes_laterales"
            android:layout_weight="1"
            android:height="@dimen/margenes_laterales"
            android:text="@string/cb2" />
        <CheckBox
            android:id="@+id/cb3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margenes_laterales"
            android:layout_marginTop="@dimen/margenes_arriba"
            android:layout_marginEnd="@dimen/margenes_laterales"
            android:layout_weight="1"
            android:height="@dimen/margenes_laterales"
            android:button="@android:drawable/btn_radio"
            android:text="@string/cb3" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <RadioGroup
            android:id="@+id/rg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">


            <RadioButton
                android:id="@+id/radioButton4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margenes_laterales"
                android:layout_marginTop="@dimen/margenes_arriba"
                android:layout_marginEnd="@dimen/margenes_laterales"
                android:height="@dimen/margenes_laterales"
                android:background="#FFFFFF"
                android:buttonTint="@android:color/holo_green_dark"
                android:text="@string/radioButton4" />

            <RadioButton
                android:id="@+id/radioButton5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margenes_laterales"
                android:layout_marginTop="@dimen/margenes_arriba"
                android:layout_marginEnd="@dimen/margenes_laterales"
                android:background="#FDFDFD"
                android:buttonTint="@android:color/holo_green_dark"
                android:text="@string/radioButton5" />

        </RadioGroup>

        <Switch
            android:id="@+id/switch1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margenes_laterales"
            android:layout_marginTop="@dimen/margenes_arriba"
            android:layout_marginEnd="@dimen/margenes_laterales"
            android:buttonTint="@android:color/holo_green_dark"
            android:text="Desactivated"
            android:textOff="@string/switch_off"
            android:textOn="@string/switch_on" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout5">

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margenes_laterales"
            android:layout_marginLeft="@dimen/margenes_laterales"
            android:layout_marginTop="@dimen/margenes_arriba"
            android:layout_weight="5"
            android:progressBackgroundTint="#FF5722"
            android:progressTint="#8BC34A"
            android:thumbTint="#4CAF50" />

        <TextView
            android:id="@+id/lbSeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout6">

        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="59dp"
            android:layout_marginStart="@dimen/margenes_laterales"
            android:layout_marginTop="@dimen/margenes_arriba"
            android:layout_marginEnd="@dimen/margenes_laterales"
            android:layout_weight="0"
            android:backgroundTint="#FFC107"
            android:max="5"
            android:numStars="5"
            android:progress="2"
            android:progressTint="#FF9800" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout7">

        <EditText
            android:id="@+id/editTextText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margenes_laterales"
            android:layout_marginTop="@dimen/margenes_arriba"
            android:layout_marginEnd="@dimen/margenes_laterales"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:drawableStart="@android:drawable/ic_menu_my_calendar"
            android:ems="10"
            android:hint="@string/editTextText"
            android:inputType="text" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>