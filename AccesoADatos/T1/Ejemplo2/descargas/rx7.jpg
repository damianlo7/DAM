<!-- START product conditions modal -->
<div class="modal fade" id="itemConditionsModal" tabindex="-1" aria-labelledby="item conditions modal"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div style="font-size: 16px;" class="modal-title " id="exampleModalLabel">Conditions and notes -
                    Condizioni e note</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table">
                    <thead class="table-dark">
                    <tr>
                        <th scope="col"></th>
                        <th scope="col">Conditions - Condizioni</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <th scope="row">MB</th>
                        <td>mint in original box - perfetto con scatola originale</td>
                    </tr>
                    <tr>
                        <th scope="row">M</th>
                        <td>mint without box - perfetto senza scatola</td>
                    </tr>
                    <tr>
                        <th scope="row">NM</th>
                        <td>near mint - vicino al perfetto</td>
                    </tr>
                    <tr>
                        <th scope="row">MRB</th>
                        <td>mint in repro box - perfetto con scatola riprodotta</td>
                    </tr>
                    <tr>
                        <th scope="row">NMRB</th>
                        <td>near mint in repro box - vicino al perfetto in scatola riprodotta</td>
                    </tr>
                    <tr>
                        <th scope="row">VG</th>
                        <td>very good - ottime condizioni</td>
                    </tr>
                    <tr>
                        <th scope="row">G</th>
                        <td>good - buone condizioni</td>
                    </tr>
                    <tr>
                        <th scope="row">VSC</th>
                        <td>very slightly chipped - qualche piccolo graffio</td>
                    </tr>
                    <tr>
                        <th scope="row">C</th>
                        <td>chipped - graffiato</td>
                    </tr>
                    <tr>
                        <th scope="row">B</th>
                        <td>with box - con scatola originale</td>
                    </tr>
                    <tr>
                        <th scope="row">RB</th>
                        <td>with repro box - con scatola riprodotta (replica)</td>
                    </tr>
                    <tr>
                        <th scope="row">RP</th>
                        <td>repainted - verniciato</td>
                    </tr>
                    </tbody>
                </table>

