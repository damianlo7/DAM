<script type="text/javascript">
    //AmazonPay Button Rendering
    var amazonPayButton = amazon.Pay.renderButton('#AmazonPayButton', {
        merchantId: 'A26WV7A65JR2K6',
        publicKeyId: 'LIVE-AGSIJQXT7GJVCF2SRIMK7OUK',
        ledgerCurrency: 'EUR',
        checkoutLanguage: 'en_GB',
        productType: 'PayAndShip',
        placement: 'Cart',
        buttonColor: 'LightGray'
    });

    //AmazonPay Button Action for NOT logged in users
    amazonPayButton.onClick(function () {
        if ($('#isSubmitted').val() == '1') {
            return;
        }
        $('#isSubmitted').val('1');
        
        $('#ajax_loader').removeClass('d-none');
        $.get("/en/addtocart/71325/1?isAjax=1", function (data) {
            var response = $.parseJSON(data);
            if (response.status == 'success') {
                var formValues = {
                    paymentMethod: "9",
                    languageIndex: "0"
                };
                $.post("/order/saveAnonymous", formValues, function (data) {
                    var response = $.parseJSON(data);
                    if (response.status == 'success') {
                        amazonPayButton.initCheckout({
                            createCheckoutSessionConfig: {
                                payloadJSON: response.payload,
                                signature: response.signature,
                                publicKeyId: 'LIVE-AGSIJQXT7GJVCF2SRIMK7OUK'
                            }
                        });
                    } else if (response.status == 'redirect') {
                        window.location = response.url;
                    }
                });
            } else if (response.status == 'redirect') {
                window.location = response.url;
            } else if (response.status == 'error') {
                alert(response.msg);
            }
        });
    });
</script>
<!-- END amazon pay -->

